#!/usr/bin/env bash
# feishu — 飞书官方 lark-cli 的包装：凭证由包装层加载，命令原样透传，补 lark-cli 缺的能力（自动授权、删 wiki 节点）。
#
# 用法:
#   feishu <lark-cli 子命令> …          透传，例如 feishu im messages send --params '{…}'
#   feishu init [参数]                   用已有应用的 LARK_APP_ID / _SECRET 初始化 lark-cli（首次 / 新机器）
#   feishu init --new                    没有应用时：终端显示二维码，飞书扫码创建自己的应用
#   feishu auth ensure [DOMAIN]          user token 有效直接返回；待刷新就调一次接口续期；失效则后台自动授权（无界面）
#   feishu auth bootstrap [DOMAIN]       初始化自动授权：打开专用浏览器登录飞书一次，之后 ensure 全自动
#   feishu wiki delete-node URL|TOKEN --yes   删除单个 wiki 节点（lark-cli 缺这个能力）
#   feishu config-status                 lark-cli config show（脱敏）
#   feishu --self-check [--json]         凭证 / open.feishu.cn / bot 与身份就绪（读 lark-cli doctor）
#   feishu --help-cli                    lark-cli 完整命令树
# 输出: 透传命令按 lark-cli 原样（默认 JSON，--format 可改）；包装层自身失败在 --json 时输出 {ok:false, error, code}
# 凭证: LARK_APP_ID / LARK_APP_SECRET（环境变量 > hub ~/.local/etc/obsidian.env > 项目 .env），init 后由 lark-cli 保存；user 身份由 lark-cli 自己保存
# 退出码: 0 成功 · 1 API 或网络失败 · 2 参数错 · 3 凭证或授权未就绪 · 130 中断

set -euo pipefail
export PATH="${PATH:-}:/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin"

src="${BASH_SOURCE[0]}"
while [[ -L "$src" ]]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"; src="$(readlink "$src")"; [[ "$src" == /* ]] || src="$dir/$src"
done
CLI_ROOT="$(cd -P "$(dirname "$src")/.." && pwd)"
# shellcheck source=../../lib/hubenv.sh
source "${CLI_ROOT}/../lib/hubenv.sh"
# shellcheck source=../../lib/uvrun.sh
source "${CLI_ROOT}/../lib/uvrun.sh"
hubenv_load

JSON_MODE=0
for a in "$@"; do [[ "$a" == --json ]] && JSON_MODE=1; done

log() { local level="$1"; shift; printf '[feishu %s] %s %s\n' "$(date +%H:%M:%S)" "$level" "$*" >&2; }
fail() {
    local code="$1"; shift
    log error "$*"
    [[ "$JSON_MODE" == 1 ]] && jq -nc --arg e "$*" --argjson c "$code" '{ok:false,error:$e,code:$c}'
    exit "$code"
}
usage() { awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$src"; }
require_lark() { command -v lark-cli >/dev/null 2>&1 || fail 3 "lark-cli 未安装（npm i -g @larksuite/cli）"; }

self_check() {
    local c=false r=false m=false ce="" re="" me="" doctor status
    status() { jq -r --arg n "$1" '.checks[]? | select(.name == $n) | .status' <<<"$doctor"; }
    # 以 lark-cli 实际生效的应用配置为准：init 之后凭证存在 lark-cli 里，环境变量可以不在
    if ! command -v lark-cli >/dev/null 2>&1; then ce="lark-cli 未安装（npm i -g @larksuite/cli）"; fi
    doctor="$(lark-cli doctor 2>/dev/null || true)"
    if [[ -z "$ce" ]]; then
        if ! jq -e .checks >/dev/null 2>&1 <<<"$doctor"; then ce="lark-cli doctor 无输出"
        elif [[ "$(status config_file)" != pass || "$(status app_resolved)" != pass ]]; then ce="lark-cli 未初始化（运行 feishu init；没有应用就 feishu init --new 扫码创建）"
        else c=true; fi
    fi
    # 未初始化时 doctor 不探测端点，不能报成网络不通
    case "$(status endpoint_open 2>/dev/null)" in
        pass) r=true ;;
        "") re="skipped" ;;
        *) re="open.feishu.cn 不可达" ;;
    esac
    if $c && $r; then
        if [[ "$(status bot_identity)" == pass && "$(status identity_ready)" == pass ]]; then m=true
        else me="身份未就绪（bot=$(status bot_identity) user=$(status user_identity)；运行 feishu auth ensure）"; fi
    else me="skipped"; fi
    local user; user="$(status user_identity 2>/dev/null || true)"
    local ok=false code=0
    if $c && $r && $m; then ok=true; elif ! $c || [[ -n "$me" && "$me" != skipped ]]; then code=3; else code=1; fi
    if [[ "$JSON_MODE" == 1 ]]; then
        jq -nc --argjson ok "$ok" --arg u "${user:-unknown}" \
            --argjson c "$c" --arg ce "$ce" --argjson r "$r" --arg re "$re" --argjson m "$m" --arg me "$me" \
            'def chk($o; $x): {ok: $o} + (if $x != "" then {error: $x} else {} end);
             {cli:"feishu", ok:$ok, user_identity:$u, checks:{credentials:chk($c;$ce), reachable:chk($r;$re), minimal_call:chk($m;$me)}}'
    else
        printf 'feishu self-check（user 身份：%s）\n  credentials   %s\n  reachable     %s\n  minimal_call  %s\n' "${user:-unknown}" \
            "$($c && echo PASS || echo "FAIL ($ce)")" "$($r && echo PASS || echo "FAIL ($re)")" "$($m && echo PASS || echo "FAIL ($me)")"
    fi
    exit "$code"
}

wiki_delete_node() {
    local target="${1:-}" confirm=0 node info code space obj type title
    [[ -n "$target" && "$target" != -* ]] || fail 2 "用法: feishu wiki delete-node URL|NODE_TOKEN --yes"
    shift
    for a in "$@"; do [[ "$a" == --yes || "$a" == -y ]] && confirm=1; done
    if [[ "$target" == *"/wiki/"* ]]; then node="$(sed -E 's|.*/wiki/([^/?#]+).*|\1|' <<<"$target")"; else node="$target"; fi
    [[ "$node" =~ ^[A-Za-z0-9]+$ ]] || fail 2 "无法识别的 wiki 节点: $target"

    info="$(lark-cli wiki spaces get_node --params "{\"token\":\"$node\"}" --as user 2>/dev/null || true)"
    code="$(jq -r '.code // -1' <<<"$info" 2>/dev/null || true)"
    [[ -n "$code" ]] || code=-1
    if [[ "$code" != 0 ]]; then
        printf '%s\n' "$info" >&2
        # 99991x 应用凭证错，99992x 用户 token 错
        [[ "$code" =~ ^9999[12] ]] && fail 3 "节点查询鉴权失败（code ${code}；运行 feishu auth ensure）"
        fail 1 "节点查询失败（token ${node}，code ${code}）"
    fi
    space="$(jq -r '.data.node.space_id' <<<"$info")"
    obj="$(jq -r '.data.node.obj_token' <<<"$info")"
    type="$(jq -r '.data.node.obj_type' <<<"$info")"
    title="$(jq -r '.data.node.title // "无标题"' <<<"$info")"
    log info "待删：${title}（${type}，space ${space}，node ${node}）"
    if [[ "$confirm" != 1 ]]; then
        [[ -t 0 && -t 2 ]] || fail 2 "删除需要确认：加 --yes"
        printf '[feishu] 确认删除「%s」? [y/N] ' "$title" >&2
        read -r ans
        [[ "$ans" =~ ^[yY]$ ]] || fail 1 "已取消"
    fi
    # 删除是异步任务，返回 task_id 即生效
    exec lark-cli api DELETE "/open-apis/wiki/v2/spaces/${space}/nodes/${obj}" --data "{\"obj_type\":\"$type\"}" --as user
}

user_token() {  # 输出: tokenStatus identity expiresAt
    local status
    status="$(lark-cli auth status 2>/dev/null || echo '{}')"
    jq -r '[(.identities.user.tokenStatus // .tokenStatus // "missing"), (.identity // "bot"),
            (.identities.user.expiresAt // .expiresAt // "?")] | join(" ")' <<<"$status"
}

auth_ensure() {
    local domain="${1:-}" token identity expires raw init url device user_code
    [[ "$domain" != -* ]] || fail 2 "用法: feishu auth ensure [DOMAIN]"
    read -r token identity expires <<<"$(user_token)"
    if [[ "$identity" == user && "$token" == needs_refresh ]]; then
        # access token 过期但 refresh token 还在：任意一次 user 调用就会续期，不必重新授权
        log info "user token 待刷新，调一次接口续期…"
        lark-cli api GET /open-apis/authen/v1/user_info --as user >/dev/null 2>&1 || true
        read -r token identity expires <<<"$(user_token)"
    fi
    if [[ "$token" == valid && "$identity" == user ]]; then
        log info "user token 有效（到期 ${expires}）"
        exit 0
    fi
    if [[ -f "${FEISHU_AUTH_PROFILE:-$HOME/.local/state/feishu/playwright-profile}/.feishu-auth-ready" ]]; then
        log info "user token ${token}，后台自动授权…"
        uv_exec "${CLI_ROOT}/cli/auth_browser.py" ${domain:+--domain "$domain"}
    fi
    log warn "自动授权还没初始化（运行一次 feishu auth bootstrap），本次走手动设备授权"
    local args=(auth login --no-wait --json)
    if [[ -n "$domain" ]]; then args+=(--domain "$domain"); else args+=(--recommend); fi
    raw="$(lark-cli "${args[@]}" 2>&1)" || { printf '%s\n' "$raw" >&2; fail 3 "设备授权启动失败"; }
    # lark-cli 可能先输出 [WARN] 行，只取第一行 JSON
    init="$(grep -m1 '^{' <<<"$raw" || true)"
    [[ -n "$init" ]] || { printf '%s\n' "$raw" >&2; fail 3 "设备授权输出里没有 JSON"; }
    url="$(jq -r '.verification_uri_complete // .verification_uri // .verification_url // .verificationUriComplete // .verificationUri // .verificationUrl // empty' <<<"$init")"
    device="$(jq -r '.device_code // .deviceCode // empty' <<<"$init")"
    user_code="$(jq -r '.user_code // .userCode // empty' <<<"$init")"
    [[ -n "$url" && -n "$device" ]] || fail 3 "解析授权地址或 device_code 失败"
    log info "授权地址：${url}${user_code:+（user code ${user_code}）}"
    open "$url" 2>/dev/null || true
    # 阻塞轮询，直到浏览器里确认授权
    exec lark-cli auth login --device-code "$device"
}

auth_bootstrap() {
    local domain="${1:-}"
    [[ "$domain" != -* ]] || fail 2 "用法: feishu auth bootstrap [DOMAIN]"
    uv_exec "${CLI_ROOT}/cli/auth_browser.py" --bootstrap ${domain:+--domain "$domain"}
}

case "${1:-}" in
    "") usage >&2; fail 2 "缺子命令（feishu --help）" ;;
    -h|--help|help) usage; exit 0 ;;
    --self-check|self-check) self_check ;;
    --help-cli) require_lark; exec lark-cli --help ;;
    init)
        shift
        require_lark
        if [[ "${1:-}" == --new ]]; then
            shift
            log info "终端会显示二维码和链接：用飞书扫码，按页面提示创建应用；完成前命令会一直等待"
            exec lark-cli config init --new "$@"
        fi
        [[ -n "${LARK_APP_ID:-}" && -n "${LARK_APP_SECRET:-}" ]] \
            || fail 3 "缺 LARK_APP_ID / LARK_APP_SECRET（环境变量或 ~/.local/etc/obsidian.env）；没有现成应用就运行 feishu init --new 扫码创建"
        log info "用已有应用凭证初始化 lark-cli（app_id ${LARK_APP_ID}）"
        printf '%s' "$LARK_APP_SECRET" | lark-cli config init --app-id "$LARK_APP_ID" --app-secret-stdin "$@"
        ;;
    config-status) require_lark; exec lark-cli config show ;;
    wiki)
        require_lark
        if [[ "${2:-}" == delete-node ]]; then shift 2; wiki_delete_node "$@"; fi
        shift; exec lark-cli wiki "$@"
        ;;
    auth)
        require_lark
        if [[ "${2:-}" == ensure ]]; then shift 2; auth_ensure "$@"; fi
        if [[ "${2:-}" == bootstrap ]]; then shift 2; auth_bootstrap "$@"; fi
        exec lark-cli "$@"
        ;;
    --profile) require_lark; exec lark-cli "$@" ;;
    -v|--version) require_lark; exec lark-cli --version ;;
    -*) fail 2 "未知参数: $1" ;;
    *) require_lark; exec lark-cli "$@" ;;
esac
